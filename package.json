{
  "name": "wstudio",
  "private": true,
  "version": "1.0.0",
  "description": "WStudio — rapports Markdown professionnels : projets, aperçu paginé fidèle, export PDF direct",
  "author": "Laurent Raphael",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "patch-package",
    "dev": "concurrently -k -s first \"vite --strictPort --host 127.0.0.1\" \"wait-on tcp:127.0.0.1:5173 && electron .\"",
    "dist": "tsc -b && vite build && electron-builder --win",
    "lint": "oxlint"
  },
  "build": {
    "appId": "io.github.stein900.wstudio",
    "productName": "WStudio",
    "directories": {
      "output": "release",
      "buildResources": "buildResources"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "buildResources/icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "shortcutName": "WStudio"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@uiw/react-codemirror": "^4.25.11",
    "@vscode/markdown-it-katex": "^1.1.2",
    "highlight.js": "^11.11.1",
    "katex": "^0.18.2",
    "markdown-it": "^15.0.0",
    "mermaid": "^11.16.1",
    "openai": "^7.4.0",
    "pagedjs": "^0.4.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tiptap-markdown": "^0.9.0",
    "tiptap-pagination-plus": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  }
}
